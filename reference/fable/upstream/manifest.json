  "licenseNote": "Upstream LICENSE at the pinned commit (MIT-to-Apache-2.0 transition statement, Apache-2.0 text, and MIT text) is preserved verbatim at upstream/ext-apps/LICENSE; each copied example's package.json declares MIT. See THIRD_PARTY_NOTICES.md.",
  "exclusions": [
    {
      "upstreamPath": "examples/*/main.ts",
      "reason": "Standalone Express port listener with broad development CORS middleware; the gallery's Hono gateway owns routing and the public-runtime envelope, and the plan excludes standalone listeners from the production path."
    },
    {
      "upstreamPath": "examples/*/.gitignore",
      "reason": "Repository housekeeping file, not source."
    },
    {
      "upstreamPath": "examples/basic-host/serve.ts",
      "reason": "Unused dev-only Express server reference; the browser-test harness reimplements it as tests/browser/harness-server.mjs (in-memory serving, no per-request filesystem access). Removed after CodeQL flagged its unbounded per-request file serving (js/missing-rate-limiting); the gallery never executes it."
    }
  ],
  "devOnly": [
    {
      "path": "upstream/ext-apps/basic-host",
      "reason": "Upstream basic host, used exclusively as the local browser-test harness (contract/browser proof). Never deployed and never part of the Vercel function or CDN output."
    }
  ],
