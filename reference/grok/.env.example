# Local tunnel or explicit public origin. Never trust an arbitrary Host header.
# BASE_URL=http://127.0.0.1:8787
# Comma-separated browser origins allowed to call MCP endpoints.
# ALLOWED_BROWSER_ORIGINS=http://127.0.0.1:8787
# Comma-separated slugs to disable. This can only remove apps, never add them.
# DISABLED_APP_SLUGS=
