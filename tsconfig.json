{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "dom-speech-recognition"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "app.ts",
    "src/**/*",
    "upstream/ext-apps/**/*.ts",
    "upstream/ext-apps/**/*.tsx",
    "tests/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "upstream/ext-apps/*/dist"]
}
