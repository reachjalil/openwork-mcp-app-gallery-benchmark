{
  "name": "openwork-mcp-app-gallery-grok",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Independent hosted gallery of official MCP Apps examples. Not an official Model Context Protocol service.",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "pnpm run build:vercel",
    "build:resources": "node scripts/bundle-mcp-app-resources.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "build:vercel": "pnpm run build:resources && pnpm run build:gallery",
    "test": "pnpm run test:unit && pnpm run test:gateway && pnpm run test:contract && pnpm run test:browser",
    "test:unit": "vitest run tests/unit",
    "test:gateway": "vitest run tests/gateway",
    "test:contract": "vitest run tests/contract",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:notices": "node scripts/verify-notices.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:vercel": "node scripts/check-vercel-architecture.mjs",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:boundary": "node scripts/scan-source-boundary.mjs",
    "release:check": "pnpm install --frozen-lockfile && pnpm run audit:ci && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build:vercel && pnpm run test:unit && pnpm run test:gateway && pnpm run test:contract && pnpm run test:browser && pnpm run verify:notices && pnpm run check:upstream && pnpm run check:vercel && pnpm run scan:secrets && pnpm run scan:boundary && pnpm run sbom"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "chart.js": "4.5.1",
    "hono": "4.13.2",
    "mcp-handler": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
